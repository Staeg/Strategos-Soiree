{
  "name": "strategos-soiree",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @soiree/client",
    "build": "npm run build -w @soiree/client",
    "preview": "npm run preview -w @soiree/client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "arena": "npm run arena -w @soiree/sim --",
    "jungle": "npm run jungle -w @soiree/sim --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
